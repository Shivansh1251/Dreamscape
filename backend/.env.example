PORT=3000
NODE_ENV=development

# ── API KEYS ──
OPENAI_API_KEY=your_openai_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
PEXELS_API_KEY=your_pexels_api_key_here
GEOAPIFY_API_KEY=your_geoapify_api_key_here
FOURSQUARE_API_KEY=your_foursquare_places_api_key_here

# â”€â”€ LIVE SEARCH & BOOKING PROVIDERS â”€â”€
# Amadeus uses OAuth client credentials for flights and supported hotel search.
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_ENV=test

# Hotelbeds needs both values; requests also use a time-based request signature.
HOTELBEDS_API_KEY=your_hotelbeds_api_key
HOTELBEDS_SECRET=your_hotelbeds_secret
HOTELBEDS_ENV=test

# ── DATABASE ──
# For MongoDB Atlas, use your connection string here. (e.g. mongodb+srv://<username>:<password>@cluster0...)
MONGO_URI=mongodb://localhost:27017/dreamscapes

# ── GOOGLE AUTHENTICATION ──
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# The Authorized Redirect URI you need to paste into the Google Cloud Console:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# URL where the React app is running. Google login always redirects here after success/failure.
FRONTEND_URL=http://localhost:5173

# ── SESSIONS & SECURITY ──
SESSION_SECRET=super_secret_session_key_replace_me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
